generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  password        String // <--- Make sure this line exists in your User model
  role            String           @default("EMPLOYEE")
  department      String?
  tasks           Task[]
  trainingsTaught TrainingModule[] @relation("TrainerModules")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  enrollments     Enrollment[]
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  createdAt   DateTime   @default(now())
}

model Enrollment {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingModuleId String
  trainingModule   TrainingModule @relation(fields: [trainingModuleId], references: [id], onDelete: Cascade)
  status           String         @default("ENROLLED") // ENROLLED, COMPLETED
  enrolledAt       DateTime       @default(now())

  @@unique([userId, trainingModuleId])
}

model TrainingModule {
  id          String       @id @default(uuid())
  title       String
  description String
  trainerId   String
  trainer     User         @relation("TrainerModules", fields: [trainerId], references: [id])
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
}

enum Role {
  ADMIN
  HR_MANAGER
  EMPLOYEE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}
